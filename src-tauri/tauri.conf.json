{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "scrme",
  "version": "0.1.2",
  "identifier": "com.sombochea.scrme",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Sambo Chea",
    "copyright": "Copyright \u00a9 2026 Sambo Chea. MIT License.",
    "category": "Productivity",
    "shortDescription": "Tiny, fast screenshot app for the menu bar",
    "longDescription": "scrme is a tiny, fast, open-source screenshot app. Press a shortcut, drag an area, and it is on your clipboard. Includes a quick annotation editor and in-app updates.",
    "homepage": "https://github.com/cubetiqlabs/scrme",
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "dmg/background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxMkFDM0NDQTIzMkJGQzUKUldURnZ6S2l6TU1xOGMyeW5ucERkOEt2K09WTG9TSUt3bGs2cTZuM0JpeVh1Z0VnalI1Ti81TTMK",
      "endpoints": [
        "https://github.com/cubetiqlabs/scrme/releases/latest/download/latest.json"
      ]
    }
  }
}
